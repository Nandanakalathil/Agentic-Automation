{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "model-pipeline/endpoint-schema/v2-bio",
  "title": "Standard inference endpoint contract (synthetic biology / protein ML)",
  "description": "Every endpoint deployed by the pipeline accepts `request` and returns `response` (HTTP 200) or `error` (HTTP 4xx/5xx). Keep the three top-level keys under $defs; the pipeline reads them by name.\n\nTyped-where-it-matters: an input or output object carrying a `type` key MUST match the matching biological definition below, so a malformed FASTA or a truncated PDB is rejected at the edge rather than inside the model. Anything without a `type` key (plain strings, numbers, arrays, free-form objects) passes through untouched, so non-biological models still work unchanged.\n\nLarge payloads: SageMaker caps a request at 6 MB. Structures and MSAs above ~1 MB should be passed by `uri` (s3:// or https://) instead of inline `data`.",

  "$defs": {
    "request": {
      "type": "object",
      "required": ["inputs"],
      "additionalProperties": false,
      "properties": {
        "request_id": {"type": "string", "maxLength": 128},
        "inputs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "description": "Batch of model inputs. Use a typed object (see bio_input) for biological payloads; plain strings/numbers/objects are accepted for everything else.",
          "items": {"$ref": "#/$defs/input_item"}
        },
        "parameters": {
          "type": "object",
          "description": "Optional model-specific inference parameters (e.g. num_designs, temperature, num_recycles, threshold).",
          "default": {}
        }
      }
    },

    "input_item": {
      "description": "Typed when it declares a `type`, free-form otherwise.",
      "if": {"type": "object", "required": ["type"]},
      "then": {"$ref": "#/$defs/bio_input"},
      "else": true
    },

    "bio_input": {
      "oneOf": [
        {"$ref": "#/$defs/sequence_input"},
        {"$ref": "#/$defs/structure_input"},
        {"$ref": "#/$defs/msa_input"},
        {"$ref": "#/$defs/molecule_input"}
      ]
    },

    "sequence_input": {
      "title": "Protein / nucleotide sequence",
      "type": "object",
      "required": ["type", "sequence"],
      "additionalProperties": false,
      "properties": {
        "type": {"enum": ["protein", "dna", "rna"]},
        "sequence": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100000,
          "description": "Residues or bases, no FASTA header, no whitespace. IUPAC letters; '-' and '.' are gap characters; '*' terminates.",
          "pattern": "^[A-Za-z*.-]+$"
        },
        "id": {"type": "string", "maxLength": 128},
        "name": {"type": "string", "maxLength": 256},
        "chain": {"type": "string", "maxLength": 4}
      }
    },

    "structure_input": {
      "title": "3D structure (PDB / mmCIF)",
      "type": "object",
      "required": ["type", "format"],
      "additionalProperties": false,
      "oneOf": [{"required": ["data"]}, {"required": ["uri"]}],
      "properties": {
        "type": {"const": "structure"},
        "format": {"enum": ["pdb", "mmcif", "cif"]},
        "data": {"type": "string", "maxLength": 5000000, "description": "Inline file contents. Prefer `uri` above ~1 MB."},
        "uri": {"type": "string", "pattern": "^(s3|https)://", "maxLength": 2048},
        "id": {"type": "string", "maxLength": 128},
        "chains": {
          "type": "array",
          "maxItems": 64,
          "items": {"type": "string", "maxLength": 4},
          "description": "Restrict to these chain ids; omit for all."
        }
      }
    },

    "msa_input": {
      "title": "Multiple sequence alignment",
      "type": "object",
      "required": ["type", "format"],
      "additionalProperties": false,
      "oneOf": [{"required": ["data"]}, {"required": ["uri"]}],
      "properties": {
        "type": {"const": "msa"},
        "format": {"enum": ["a3m", "sto", "fasta", "aligned_fasta"]},
        "data": {"type": "string", "maxLength": 5000000},
        "uri": {"type": "string", "pattern": "^(s3|https)://", "maxLength": 2048},
        "depth": {"type": "integer", "minimum": 1, "description": "Optional cap on sequences used."}
      }
    },

    "molecule_input": {
      "title": "Small molecule / ligand",
      "type": "object",
      "required": ["type", "format", "data"],
      "additionalProperties": false,
      "properties": {
        "type": {"const": "molecule"},
        "format": {"enum": ["smiles", "inchi", "sdf", "mol2"]},
        "data": {"type": "string", "minLength": 1, "maxLength": 1000000},
        "id": {"type": "string", "maxLength": 128}
      }
    },

    "response": {
      "type": "object",
      "required": ["request_id", "model", "outputs", "latency_ms"],
      "additionalProperties": false,
      "properties": {
        "request_id": {"type": "string"},
        "model": {
          "type": "object",
          "required": ["name", "version"],
          "properties": {
            "name": {"type": "string"},
            "version": {"type": "string"}
          }
        },
        "outputs": {
          "type": "array",
          "description": "One output per input, same order as `inputs`.",
          "items": {"$ref": "#/$defs/output_item"}
        },
        "latency_ms": {"type": "number", "minimum": 0},
        "warnings": {"type": "array", "items": {"type": "string"}, "maxItems": 32}
      }
    },

    "output_item": {
      "description": "Typed when it declares a `type`, free-form otherwise.",
      "if": {"type": "object", "required": ["type"]},
      "then": {"$ref": "#/$defs/bio_output"},
      "else": true
    },

    "bio_output": {
      "oneOf": [
        {"$ref": "#/$defs/sequence_output"},
        {"$ref": "#/$defs/structure_output"},
        {"$ref": "#/$defs/scores_output"}
      ]
    },

    "sequence_output": {
      "title": "Designed or predicted sequence",
      "type": "object",
      "required": ["type", "sequence"],
      "additionalProperties": false,
      "properties": {
        "type": {"enum": ["protein", "dna", "rna"]},
        "sequence": {"type": "string", "minLength": 1, "pattern": "^[A-Za-z*.-]+$"},
        "id": {"type": "string"},
        "score": {"type": "number", "description": "Model-defined, e.g. ProteinMPNN global score."},
        "per_residue": {
          "type": "array",
          "items": {"type": "number"},
          "description": "One value per residue, e.g. per-position confidence or log-probability."
        },
        "metrics": {"type": "object", "description": "Scalar metrics, e.g. {\"perplexity\": 3.1}."}
      }
    },

    "structure_output": {
      "title": "Predicted structure with confidence",
      "type": "object",
      "required": ["type", "format"],
      "additionalProperties": false,
      "oneOf": [{"required": ["data"]}, {"required": ["uri"]}],
      "properties": {
        "type": {"const": "structure"},
        "format": {"enum": ["pdb", "mmcif", "cif"]},
        "data": {"type": "string", "maxLength": 5000000},
        "uri": {"type": "string", "pattern": "^(s3|https)://", "maxLength": 2048},
        "id": {"type": "string"},
        "plddt": {
          "type": "array",
          "items": {"type": "number", "minimum": 0, "maximum": 100},
          "description": "Per-residue pLDDT (0-100)."
        },
        "mean_plddt": {"type": "number", "minimum": 0, "maximum": 100},
        "ptm": {"type": "number", "minimum": 0, "maximum": 1},
        "iptm": {"type": "number", "minimum": 0, "maximum": 1},
        "pae_uri": {"type": "string", "pattern": "^(s3|https)://", "maxLength": 2048,
                    "description": "Predicted aligned error matrix; by reference since it is O(n^2)."},
        "metrics": {"type": "object"}
      }
    },

    "scores_output": {
      "title": "Numeric prediction (property, annotation, ranking)",
      "type": "object",
      "required": ["type"],
      "additionalProperties": false,
      "properties": {
        "type": {"const": "scores"},
        "id": {"type": "string"},
        "label": {"type": "string", "description": "e.g. an EC number from CLEAN, or a class name."},
        "score": {"type": "number"},
        "per_residue": {"type": "array", "items": {"type": "number"}},
        "labels": {
          "type": "array",
          "maxItems": 1000,
          "items": {
            "type": "object",
            "required": ["label", "score"],
            "properties": {"label": {"type": "string"}, "score": {"type": "number"}}
          },
          "description": "Ranked candidates, e.g. top-k EC numbers or GO terms."
        },
        "metrics": {"type": "object"}
      }
    },

    "error": {
      "type": "object",
      "required": ["request_id", "error"],
      "additionalProperties": false,
      "properties": {
        "request_id": {"type": "string"},
        "error": {
          "type": "object",
          "required": ["code", "message"],
          "properties": {
            "code": {"type": "string", "enum": ["INVALID_REQUEST", "MODEL_ERROR", "TIMEOUT", "INTERNAL"]},
            "message": {"type": "string"}
          }
        }
      }
    }
  }
}
