# --- secrets -----------------------------------------------------------
.env
*.pem
aws_credentials_backup.txt

# --- pipeline output ---------------------------------------------------
# Keep the generated reports; drop everything else a run leaves behind. The
# clone under repo/ is someone else's source tree, and .state/ holds agent
# transcripts (which quote that source), the checkpoint db and the ledger.
# Layout: outputs/<repo>/agent<n>/run<k>/
outputs/**
!outputs/**/
!outputs/**/*.md
# The clone has its own .git, so naming only its contents makes git add it as a
# submodule gitlink instead. The directory itself has to be excluded.
outputs/**/repo
outputs/**/repo/**
outputs/**/.state
outputs/**/.state/**

# --- environments and caches -------------------------------------------
.venv/
venv/
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- os / editor -------------------------------------------------------
.DS_Store
.idea/
.vscode/

# --- local scratch -----------------------------------------------------
alphafast-run/
*.zip
