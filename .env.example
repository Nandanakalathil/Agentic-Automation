# Copy to .env and fill in. Never commit .env.
# Key for the LLM provider set in config/pipeline.yaml (llm.base_url).
# Get one free at https://build.nvidia.com
NVIDIA_API_KEY=nvapi-...
PIPELINE_ARTIFACT_BUCKET=model-pipeline-artifacts-<account>-us-east-1
AWS_REGION=us-east-1
# Optional: AWS_PROFILE=my-profile
# Optional, for private repos: put a token in the URL you pass to `run`, or configure git credentials.
